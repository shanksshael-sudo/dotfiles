* {
  bg:       #0d0d14f0;
  bg-alt:   #1a1a2ecc;
  fg:       #e0e0e0;
  accent:   #00f5ff;
  dim:      #7777aa;
  font:     "JetBrainsMono Nerd Font 11";
  background-color: transparent;
  text-color: @fg;
}
window {
  background-color: @bg;
  border:           1px solid;
  border-color:     @accent;
  border-radius:    14px;
  width:            480px;
  padding:          10px;
}
mainbox {
  background-color: transparent;
  children: [inputbar, listview];
  spacing: 8px;
  padding: 8px;
}
inputbar {
  background-color: @bg-alt;
  border-radius:    10px;
  padding:          10px 14px;
  children:         [prompt, entry];
}
prompt { text-color: @accent; padding: 0 8px 0 0; }
entry  { placeholder: "Search..."; placeholder-color: @dim; }
listview {
  background-color: transparent;
  lines: 8; columns: 1; spacing: 4px;
}
element {
  background-color: transparent;
  border-radius: 8px;
  padding: 9px 12px;
  spacing: 10px;
  children: [element-icon, element-text];
  cursor: pointer;
}
element normal.normal  { background-color: transparent; }
element normal.urgent  { background-color: transparent; text-color: #ff4466; }
element selected.normal { background-color: @accent; text-color: #0a0a0f; }
element-icon { size: 22px; }
element-text { vertical-align: 0.5; }
