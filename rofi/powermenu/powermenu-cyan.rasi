/**
 * Cyan-Black / Audiowide — Power Menu
 */
* {
    bg-col:           #0a0e14ee;
    bg-col-light:     #10151ce6;
    border-col:       #00e5ffff;
    selected-col:     #00e5ffcc;
    fg-col:           #c8f6ffff;
    fg-col-selected:  #071018ff;
    grey:             #7a8a99ff;
    font: "Audiowide 11";
}

window {
    transparency: "real";
    background-color: @bg-col;
    border:        2px;
    border-color:  @border-col;
    border-radius: 14px;
    width:  620px;
    padding: 26px 20px;
    location: center;
}

mainbox {
    background-color: transparent;
    children: [ "message", "listview" ];
}

message {
    background-color: transparent;
    padding: 0 0 16px 0;
    border: 0;
}

textbox {
    text-color: @fg-col;
    horizontal-align: 0.5;
    font: "Audiowide 12";
}

listview {
    columns: 5;
    lines:   1;
    spacing: 14px;
    background-color: transparent;
    cycle: true;
    fixed-height: true;
}

element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    background-color: @bg-col-light;
    text-color: @fg-col;
    border-radius: 10px;
    border: 1px;
    border-color: #00e5ff00;
    padding: 14px 6px 10px 6px;
    spacing: 0;
}

element-icon {
    size: 36px;
    horizontal-align: 0.5;
    background-color: transparent;
    padding: 0;
}

element-text {
    expand: false;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    margin: 6px 0 0 0;
    padding: 0;
    font: "Audiowide 8";
    background-color: transparent;
    text-color: #ffffff;
}

element selected {
    background-color: @selected-col;
    text-color: @fg-col-selected;
    border-color: @border-col;
}
